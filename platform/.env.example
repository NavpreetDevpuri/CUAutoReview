# Hosted calls are off by default. Replay the retained POC without provider charges.
ALLOW_HOSTED_INFERENCE=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional Codex-specific API key; otherwise Codex uses OPENAI_API_KEY in its one-shot child process.
CODEX_API_KEY=
# Codex account region. Set the API origin returned by provider preflight; only the official global and US endpoints are accepted.
CUAUTOREVIEW_CODEX_BASE_URL=https://api.openai.com/v1
# Optional managed-service endpoints. Empty values keep the local Compose defaults.
CUAUTOREVIEW_DATABASE_URL=
CUAUTOREVIEW_BROKER_URL=
CUAUTOREVIEW_S3_ENDPOINT=
CUAUTOREVIEW_S3_BUCKET=
CUAUTOREVIEW_S3_ACCESS_KEY=
CUAUTOREVIEW_S3_SECRET_KEY=
CUAUTOREVIEW_S3_REGION=

# Production only (platform/compose.prod.yaml): the values above plus these are required, and none may reuse
# the committed local credentials. See platform/docs/DEPLOYMENT.md.
CUAUTOREVIEW_PUBLIC_ORIGIN=
CUAUTOREVIEW_POSTGRES_PASSWORD=
CUAUTOREVIEW_RABBITMQ_PASSWORD=
# Path on the host to a SeaweedFS identity file holding CUAUTOREVIEW_S3_ACCESS_KEY/SECRET_KEY.
CUAUTOREVIEW_S3_IDENTITIES=
# Optional production tuning.
# CUAUTOREVIEW_WEB_WORKERS=2
# CUAUTOREVIEW_FORWARDED_ALLOW_IPS=*
# CUAUTOREVIEW_ALLOW_SIGNUP=false
# CUAUTOREVIEW_LOG_LEVEL=INFO
